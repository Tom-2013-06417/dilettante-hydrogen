# Copy to .env for local development.
# After linking your store, run `npx shopify hydrogen env pull` to populate Shopify vars.

# Required locally. Use a long random string in production (e.g. `openssl rand -hex 32`).
SESSION_SECRET=

# Pre-launch gate. Leave unset/false to show only the teaser page.
# Set to true when the storefront should go public.
# This is app-level (not Shopify storefront password protection).
PUBLIC_SITE_LAUNCHED=false
# Optional shared secret to unlock the full site while gated.
# Set cookie site_preview=<this value> in the browser.
SITE_PREVIEW_TOKEN=

# Pre-orders — set differently on each Oxygen environment:
# PUBLIC_DEPLOYMENT=preview          # preview / staging URL
# PUBLIC_DEPLOYMENT=production       # live URL
# PUBLIC_PREORDERS_LIVE=true         # production only, when pre-orders go live

# Populated by `shopify hydrogen env pull` after linking:
# PUBLIC_STORE_DOMAIN=
# PUBLIC_STOREFRONT_API_TOKEN=
# PUBLIC_STOREFRONT_ID=
# PUBLIC_CHECKOUT_DOMAIN=
# PUBLIC_META_PIXEL_ID=
# PRIVATE_STOREFRONT_API_TOKEN=
# PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
# PUBLIC_CUSTOMER_ACCOUNT_API_URL=
# SHOP_ID=

# Teaser mailing list (Dev Dashboard app — not the Hydrogen channel).
# Create app → set scopes read_customers + write_customers → Release version → Install on store.
# Then copy Client ID + Secret from Settings:
# https://shopify.dev/docs/apps/build/dev-dashboard/get-api-access-tokens
# SHOPIFY_APP_CLIENT_ID=
# SHOPIFY_APP_CLIENT_SECRET=
